{
  "family": "ecobin-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::051131629311:role/ecobin-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::051131629311:role/ecobin-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "051131629311.dkr.ecr.ap-south-1.amazonaws.com/ecobin-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "AWS_DEFAULT_REGION", "value": "ap-south-1"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecobin-web",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "web"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/api/docs/ || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 120
      }
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 6379,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD", "redis-cli", "ping"],
        "interval": 10,
        "timeout": 5,
        "retries": 5
      }
    }
  ]
}
